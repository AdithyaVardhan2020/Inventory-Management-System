{
  "info": {
    "_postman_id": "beedb221-f53b-4055-9090-6b71abf3e961",
    "name": "Inventory API Collection",
    "description": "Inventory Management System REST API — Week 5 with validation, search, and statistics (Spring Boot on port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"staff1\",\n  \"password\": \"pass123\",\n  \"role\": \"staff\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/all"
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/1"
          }
        },
        {
          "name": "Add Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Wireless Mouse\",\n  \"category\": \"Electronics\",\n  \"quantity\": 50,\n  \"price\": 29.99,\n  \"reorderLevel\": 10,\n  \"supplierId\": 1\n}"
            },
            "url": "{{baseUrl}}/products/add"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Wireless Mouse\",\n  \"category\": \"Electronics\",\n  \"quantity\": 45,\n  \"price\": 27.99,\n  \"reorderLevel\": 10,\n  \"supplierId\": 1\n}"
            },
            "url": "{{baseUrl}}/products/update/1"
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/products/delete/1"
          }
        },
        {
          "name": "Get Low Stock",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/low-stock"
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/search?keyword=laptop&category=Electronics",
              "host": ["{{baseUrl}}"],
              "path": ["products", "search"],
              "query": [
                { "key": "keyword", "value": "laptop" },
                { "key": "category", "value": "Electronics" }
              ]
            }
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/categories"
          }
        }
      ]
    },
    {
      "name": "Suppliers",
      "item": [
        {
          "name": "Get All Suppliers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/suppliers/all"
          }
        },
        {
          "name": "Get Supplier By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/suppliers/1"
          }
        },
        {
          "name": "Add Supplier",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierName\": \"Tech Supplies Inc\",\n  \"contactPerson\": \"Jane Doe\",\n  \"phone\": \"555-0100\",\n  \"email\": \"jane@techsupplies.com\",\n  \"address\": \"123 Main St, Denver CO\"\n}"
            },
            "url": "{{baseUrl}}/suppliers/add"
          }
        },
        {
          "name": "Update Supplier",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierName\": \"Tech Supplies Inc\",\n  \"contactPerson\": \"Jane Doe\",\n  \"phone\": \"555-0199\",\n  \"email\": \"jane@techsupplies.com\",\n  \"address\": \"456 Oak Ave, Denver CO\"\n}"
            },
            "url": "{{baseUrl}}/suppliers/update/1"
          }
        },
        {
          "name": "Delete Supplier",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/suppliers/delete/1"
          }
        },
        {
          "name": "Search Suppliers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/suppliers/search?keyword=abc",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers", "search"],
              "query": [{ "key": "keyword", "value": "abc" }]
            }
          }
        }
      ]
    },
    {
      "name": "Statistics",
      "item": [
        {
          "name": "Get Inventory Statistics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/statistics"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions/all"
          }
        }
      ]
    }
  ]
}
